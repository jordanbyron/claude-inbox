#!/usr/bin/env ruby
# frozen_string_literal: true

# M0: print parsed sections with no TUI. Pass a fixture path to skip the daemon.
require "bundler/setup"
require_relative "../lib/claude_inbox"

fixtures = File.expand_path("../test/fixtures", __dir__)
client = ARGV[0] ? ClaudeInbox::FixtureClient.new(ARGV[0]) : ClaudeInbox::AgentsClient.new
prs = ARGV[0] ? ClaudeInbox::PullRequests.new(jobs_dir: File.join(fixtures, "jobs"), cache_path: File.join(fixtures, "gh-pr-status-cache.json"), gh: nil) : ClaudeInbox::PullRequests.new
jobs = ARGV[0] ? ClaudeInbox::JobState.new(jobs_dir: File.join(fixtures, "jobs")) : ClaudeInbox::JobState.new
sessions = jobs.enrich(prs.enrich(client.list))
store = ClaudeInbox::Store.new(path: nil)
store.update(sessions)

now = Time.now
store.sections(now).each_section do |name, rows|
  puts "== #{name} (#{rows.size})"
  rows.each do |r|
    s = r.session
    age = s.started_at ? "#{((now - s.started_at) / 60).round}m" : "?"
    pr = s.prs.map { |x| "#{x.short} #{x.state || "?"}" }.join(" ")
    puts format("  %-9s %-8s %-8s %-6s %-40s %-14s %-7s %s", s.id || "-", s.state || s.kind, s.status || "-", age, r.label[0, 40], s.project, s.color || "-", pr)
  end
end
