#!/usr/bin/env ruby
# frozen_string_literal: true

# M0: print parsed sections with no TUI. Pass a fixture path to skip the daemon.
# Resolve symlinks so `ln -s .../bin/claude-inbox ~/bin/` works from any cwd:
# Bundler finds the Gemfile from this file, not from where it was invoked.
root = File.expand_path("..", File.dirname(File.realpath(__FILE__)))
ENV["BUNDLE_GEMFILE"] ||= File.join(root, "Gemfile")
require "bundler/setup"
require File.join(root, "lib", "claude_inbox")

fixtures = File.join(root, "test", "fixtures")
client = ARGV[0] ? ClaudeInbox::FixtureClient.new(ARGV[0]) : ClaudeInbox::AgentsClient.new
jobs_dir = ARGV[0] ? File.join(fixtures, "jobs") : ClaudeInbox::JobState::DEFAULT_DIR
prs = ARGV[0] ? ClaudeInbox::PullRequests.new(jobs_dir: jobs_dir, cache_path: File.join(fixtures, "gh-pr-status-cache.json"), gh: nil) : ClaudeInbox::PullRequests.new
sessions = ClaudeInbox::JobState.enrich(prs.enrich(client.list), jobs_dir: jobs_dir)
store = ClaudeInbox::Store.new(path: nil)
store.update(sessions)

now = Time.now
store.sections(now).each_section do |name, rows|
  puts "== #{name} (#{rows.size})"
  rows.each do |r|
    s = r.session
    age = s.started_at ? "#{((now - s.started_at) / 60).round}m" : "?"
    pr = s.prs.map { |x| "#{x.short} #{x.state || "?"}" }.join(" ")
    work = s.job_state&.in_flight_label
    pulse = s.waiting_on_work? ? "idle" : (s.status || "-")
    puts format("  %-9s %-8s %-8s %-6s %-40s %-14s %s", s.id || "-", s.state || s.kind, pulse, age, r.label[0, 40], s.project, [work, pr].compact.reject(&:empty?).join("  "))
  end
end
