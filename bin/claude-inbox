#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require_relative "../lib/claude_inbox"
require_relative "../lib/claude_inbox/app"

# Crash traces go here instead of the alt screen when set.
$stderr.reopen(ENV["CLAUDE_INBOX_STDERR"], "a") if ENV["CLAUDE_INBOX_STDERR"]

opts = {}
if (i = ARGV.index("--fixture"))
  fixtures = File.join(__dir__, "..", "test", "fixtures")
  opts[:client] = ClaudeInbox::FixtureClient.new(ARGV[i + 1], logs: File.binread(File.join(fixtures, "logs_raw.txt")))
  opts[:store] = ClaudeInbox::Store.new(path: nil)
  opts[:pull_requests] = ClaudeInbox::PullRequests.new(jobs_dir: File.join(fixtures, "jobs"), cache_path: File.join(fixtures, "gh-pr-status-cache.json"), gh: nil)
  opts[:job_state] = ClaudeInbox::JobState.new(jobs_dir: File.join(fixtures, "jobs"))
end
opts[:color] = false if ARGV.include?("--no-color")

ClaudeInbox::App.new(**opts).run
