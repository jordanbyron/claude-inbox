#!/usr/bin/env ruby
# frozen_string_literal: true

require "claude_inbox"

if ARGV.include?("--version")
  puts ClaudeInbox::VERSION
  exit
end

require "claude_inbox/mod"

# The stable path to the Claude Code pane, for CLAUDE_CODE_PLUGIN_DIRS.
if ARGV.include?("--mod-dir")
  puts ClaudeInbox::Mod.link(force: true)
  exit
end

if ARGV.first == "install"
  begin
    installed = ClaudeInbox::Mod.install(force: ARGV.include?("--force"))
  rescue JSON::ParserError
    abort "claude-inbox: ~/.claude/settings.json is not valid JSON, so it was left alone"
  end
  installed.removed.each { |dir| puts "Removed #{dir} from ~/.claude/settings.json." }
  puts "The pane now runs #{ClaudeInbox::Mod::COMMAND || "claude-inbox from your PATH"}." if installed.command_set
  puts installed.added ? "Added the pane to ~/.claude/settings.json. New Claude Code sessions load it; /inbox opens it." :
    "The pane is already in ~/.claude/settings.json."
  exit
end

if ARGV.first == "update"
  require "claude_inbox/updater"
  updater = ClaudeInbox::Updater.new
  begin
    update = updater.check(force: true)
  rescue ClaudeInbox::Updater::Error => e
    abort "claude-inbox: #{e.message}"
  end
  unless update
    puts((updater.kind == :gem) ? "claude-inbox #{ClaudeInbox::VERSION} is the latest release." : "main is up to date.")
    exit
  end
  puts update.installing
  applied = updater.apply
  abort "claude-inbox: #{applied.output.strip}" unless applied.success?
  puts((update.kind == :gem) ? "Installed claude-inbox #{update.latest}." : "main is at #{update.latest}.")
  exit
end

require "claude_inbox/app"
require "claude_inbox/config"
require "claude_inbox/updater"
require "claude_inbox/writer_lock"
require "tmpdir"

fixture = ARGV.include?("--fixture")
# A fixture run takes the listen flags, for trying the API with curl, but
# not the environment or the config file, which are for the real inbox.
begin
  argv = fixture ? ARGV : ClaudeInbox::Config.argv(ARGV)
  listen = ClaudeInbox::Remote::Listener.options(argv, fixture ? {} : ENV)
rescue ArgumentError => e
  abort "claude-inbox: #{e.message}"
end

# Crash traces go here instead of the alt screen when set.
$stderr.reopen(ENV["CLAUDE_INBOX_STDERR"], "a") if ENV["CLAUDE_INBOX_STDERR"]

opts = {}
if fixture
  agents = argv[argv.index("--fixture") + 1]
  fixtures = File.dirname(agents)
  opts[:client] = ClaudeInbox::FixtureClient.new(agents, logs: File.binread(File.join(fixtures, "logs_raw.txt")))
  opts[:store] = ClaudeInbox::Store.new(path: nil)
  opts[:pull_requests] = ClaudeInbox::PullRequests.new(cache_path: File.join(fixtures, "gh-pr-status-cache.json"), resolved_path: nil, gh: nil)
  # Its own token, lock and images, so a test inbox can neither rotate the
  # token phones are paired with nor hold the real inbox's lock.
  dir = File.join(Dir.tmpdir, "claude-inbox-fixture")
  opts[:listen] = listen&.merge(fixture: true, pairing: ClaudeInbox::Remote::Pairing.new(path: File.join(dir, "listen.json")),
    lock_path: File.join(dir, "listen.lock"), images_dir: File.join(dir, "images"))
else
  # The only place the reaper is armed, and only with --reap: deleting
  # sessions is opt-in. Everything else — tests, --fixture, anything
  # embedding App — gets one that deletes nothing. The listener, likewise,
  # comes only from this file, and only when asked for.
  opts[:client] = ClaudeInbox::AgentsClient.new
  opts[:store] = ClaudeInbox::Store.new
  opts[:reaper] = argv.include?("--reap") ? ClaudeInbox::Reaper.new(opts[:client], opts[:store]) : ClaudeInbox::Reaper.disabled
  opts[:snapshot] = ClaudeInbox::Snapshot.new
  opts[:switch] = ClaudeInbox::Switch.new
  opts[:actions] = ClaudeInbox::Actions.new
  opts[:pane_offer] = ClaudeInbox::Mod::Offer.new
  opts[:listen] = listen
  opts[:updater] = ClaudeInbox::Updater.new unless argv.include?("--no-update-check")
  # The typed arguments, not the config's: a relaunch reads the config again.
  opts[:argv] = ARGV
end
opts[:color] = false if argv.include?("--no-color")

if argv.include?("--headless")
  abort "claude-inbox: --headless takes no --fixture" if fixture
  require "claude_inbox/headless"
  exit(ClaudeInbox::Headless.new(client: opts[:client], store: opts[:store], updater: opts[:updater]).run ? 0 : 1)
end

# Only what a check within the day already found: a cold launch never waits
# on the network. The relaunch is the new version's launch; a failure leaves
# this one to start as usual.
if argv.include?("--auto-update") && (update = opts[:updater]&.cached)
  puts update.installing
  applied = opts[:updater].apply
  applied.success? ? opts[:updater].relaunch(ARGV) : warn("claude-inbox: #{applied.output.strip}")
end

# The first inbox you can see is the snapshot's writer: a headless one gives
# way to it, and a second inbox reads along, writing and deleting nothing.
# Held for the life of this process by this reference.
writer_lock = fixture ? ClaudeInbox::WriterLock.disabled : ClaudeInbox::WriterLock.new
unless writer_lock.take(role: "inbox")
  opts[:store] = ClaudeInbox::Store.new(writable: false, relay: ClaudeInbox::Actions.new)
  opts[:reaper] = ClaudeInbox::Reaper.disabled
  opts[:snapshot] = ClaudeInbox::Snapshot.disabled
  opts[:actions] = ClaudeInbox::Actions.disabled
  opts[:pane_offer] = ClaudeInbox::Mod::Offer.disabled
end
# So the pane settings.json names is the installed version's, after a gem update too.
ClaudeInbox::Mod.link unless fixture

ClaudeInbox::App.new(**opts).run
